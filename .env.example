# Brain: anthropic | ollama | mock  (default: anthropic if ANTHROPIC_API_KEY is set, else mock)
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OLLAMA_MODEL=llama3.1
OLLAMA_HOST=http://localhost:11434

# Server. Loopback by default. To reach it from a phone/another PC set HOST=0.0.0.0 AND a long random AUTH_TOKEN
# (then open the web app once with ?token=<AUTH_TOKEN>). Use HTTPS/a tunnel you trust if leaving your LAN.
PORT=8787
HOST=127.0.0.1
AUTH_TOKEN=

# Origins allowed to use the server from a browser when AUTH_TOKEN is NOT set (blocks other websites from
# talking to your localhost companion). Comma separated.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Voice output (natural voice). none = browser voices (robotic). Quality depends on the engine you choose.
# elevenlabs : ElevenLabs cloud voices. Needs TTS_API_KEY and a voice id in TTS_VOICE (from your voice library);
#              TTS_MODEL defaults to eleven_multilingual_v2 (check their docs for the current multilingual model).
# openai  : any server exposing POST {TTS_BASE_URL}/audio/speech (OpenAI itself, or a local server that copies that API)
# command : a local program (e.g. Piper). Text on stdin, WAV written to {out}. No shell is used.
TTS_PROVIDER=none   # none | elevenlabs | openai | command
TTS_BASE_URL=https://api.openai.com/v1
TTS_API_KEY=
TTS_MODEL=tts-1
TTS_VOICE=alloy
TTS_FORMAT=mp3
# TTS_COMMAND=piper --model "/path/to/voice.onnx" --output_file {out}

# --- Voice input (Whisper). none = browser Web Speech (Chrome/Edge, audio goes to Google).
# openai  : any server exposing POST {STT_BASE_URL}/audio/transcriptions (OpenAI, or a local Whisper server with that API)
STT_PROVIDER=none
STT_BASE_URL=https://api.openai.com/v1
STT_API_KEY=
STT_MODEL=whisper-1

# --- Tools (OFF by default). TOOLS=public_apis lets her search/read/call the public-apis catalog (GET only).
# Build the catalog first:  npm run apis:update -w @waifu/server
# Needs a brain with tool use (anthropic, or mock for demos); Ollama is not wired for tools yet.
# API keys for APIs that need them live ONLY on the server in data/api-keys.json (git-ignored), e.g.
#   { "api.example.com": { "header": "X-Api-Key", "value": "..." }, "other.com": { "query": "apikey", "value": "..." } }
# TOOLS=public_apis,screen  (screen = look_at_screen tool; needs a vision brain and the user sharing in the client)
TOOLS=
# Seconds-level pacing of unprompted screen comments ("continuous observation"), in ms.
WATCH_MIN_INTERVAL_MS=25000
# Ollama only: set to 1 if OLLAMA_MODEL is a vision-capable model.
OLLAMA_VISION=0
# PUBLIC_APIS_FILE=data/public-apis.json
# API_KEYS_FILE=data/api-keys.json

# --- Serving the app and phone access
# The server serves apps/web/dist (run `npm run build`) so one port gives UI + API. SERVE_WEB=0 to disable.
SERVE_WEB=1
# WEB_DIR=apps/web/dist
# HTTPS (required for the microphone on phones/tablets). Use a certificate your devices trust.
TLS_CERT=
TLS_KEY=
# Print a QR code with the pairing link at startup (only when HOST is not loopback and AUTH_TOKEN is set).
PAIR_QR=1

SOUL_FILE=souls/default.soul.json
MEMORY_FILE=data/memory.json
