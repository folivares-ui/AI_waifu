# Brain: anthropic | ollama | mock  (default: anthropic if ANTHROPIC_API_KEY is set, else mock)
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OLLAMA_MODEL=llama3.1
OLLAMA_HOST=http://localhost:11434

# Server. Loopback by default. To reach it from a phone/another PC set HOST=0.0.0.0 AND a long random AUTH_TOKEN
# (then open the web app once with ?token=<AUTH_TOKEN>). Use HTTPS/a tunnel you trust if leaving your LAN.
PORT=8787
HOST=127.0.0.1
AUTH_TOKEN=

# Origins allowed to use the server from a browser when AUTH_TOKEN is NOT set (blocks other websites from
# talking to your localhost companion). Comma separated.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Voice output (natural voice). none = browser voices (robotic). Quality depends on the engine you choose.
# openai  : any server exposing POST {TTS_BASE_URL}/audio/speech (OpenAI itself, or a local server that copies that API)
# command : a local program (e.g. Piper). Text on stdin, WAV written to {out}. No shell is used.
TTS_PROVIDER=none
TTS_BASE_URL=https://api.openai.com/v1
TTS_API_KEY=
TTS_MODEL=tts-1
TTS_VOICE=alloy
TTS_FORMAT=mp3
# TTS_COMMAND=piper --model "/path/to/voice.onnx" --output_file {out}

# --- Voice input (Whisper). none = browser Web Speech (Chrome/Edge, audio goes to Google).
# openai  : any server exposing POST {STT_BASE_URL}/audio/transcriptions (OpenAI, or a local Whisper server with that API)
STT_PROVIDER=none
STT_BASE_URL=https://api.openai.com/v1
STT_API_KEY=
STT_MODEL=whisper-1

SOUL_FILE=souls/default.soul.json
MEMORY_FILE=data/memory.json
