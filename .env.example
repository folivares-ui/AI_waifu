# Copy this file to .env: the server reads it automatically (values typed in the shell win; empty = default).
# Brain: anthropic | ollama | mock  (default: anthropic if ANTHROPIC_API_KEY is set, else mock)
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Backup brain: if the main one fails before answering (tokens/credits used up, rate limit, no internet),
# she continues with this one and tries the main one again after LLM_FALLBACK_RETRY_MIN minutes.
# Example: LLM_PROVIDER=anthropic + LLM_FALLBACK=ollama (Ollama must be installed and the model pulled).
LLM_FALLBACK=
# LLM_FALLBACK_RETRY_MIN=15
# Ollama = free and local (https://ollama.com). Download the model first:  ollama pull qwen2.5:3b
# For tools (open programs, edit files) the model must support tool calling: see ollama.com/search?c=tool
# With a 4 GB graphics card a ~3B model fits entirely on it; 7B models also run but partly on the CPU (slower).
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_HOST=http://localhost:11434
# OLLAMA_NUM_CTX=8192   context window (her persona + tools need more than Ollama's small default)
# OLLAMA_TOOLS=0        for models without tool support (she can then only talk)

# Server. Loopback by default. To reach it from a phone/another PC set HOST=0.0.0.0 AND a long random AUTH_TOKEN
# (then open the web app once with ?token=<AUTH_TOKEN>). Use HTTPS/a tunnel you trust if leaving your LAN.
PORT=8787
HOST=127.0.0.1
AUTH_TOKEN=

# Origins allowed to use the server from a browser when AUTH_TOKEN is NOT set (blocks other websites from
# talking to your localhost companion). Comma separated.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Voice output (natural voice). none = browser voices (robotic). Quality depends on the engine you choose.
# elevenlabs : ElevenLabs cloud voices. Needs TTS_API_KEY and a voice id in TTS_VOICE (from your voice library);
#              TTS_MODEL defaults to eleven_multilingual_v2 (check their docs for the current multilingual model).
# openai  : any server exposing POST {TTS_BASE_URL}/audio/speech (OpenAI itself, or a local server that copies that API)
# command : a local program (e.g. Piper). Text on stdin, WAV written to {out}. No shell is used.
# voicestudio : VoiceStudio running on this computer (https://github.com/debpalash/VoiceStudio): local, free, no key.
#               Defaults: http://localhost:3900/v1, model tts-1 (= its active engine), voice "default", wav, sends the
#               soul's language. Set TTS_VOICE to a saved VoiceStudio voice profile ID/name; TTS_INSTRUCTIONS for style.
TTS_PROVIDER=none   # none | voicestudio | elevenlabs | openai | command
# Language she SPEAKS in (her text stays in the soul's language, shown as subtitles). Rice's soul uses ja-JP;
# the app's Ajustes > "Hablar en japones" switch overrides this per device. es-ES = speak Spanish.
# SPEECH_LANG=ja-JP
# Leave these empty for voicestudio (its defaults are used). For OpenAI e.g.:
#   TTS_BASE_URL=https://api.openai.com/v1  TTS_MODEL=tts-1  TTS_VOICE=alloy  TTS_FORMAT=mp3
# The soul's "ttsVoice" ("Rice Shower") is used before TTS_VOICE.
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=
TTS_VOICE=
TTS_FORMAT=
# TTS_COMMAND=piper --model "/path/to/voice.onnx" --output_file {out}

# --- Voice input (Whisper). none = browser Web Speech (Chrome/Edge, audio goes to Google).
# openai  : any server exposing POST {STT_BASE_URL}/audio/transcriptions (OpenAI, or a local Whisper server with that API)
# voicestudio : VoiceStudio's transcription on this computer (http://localhost:3900/v1, model whisper-1)
STT_PROVIDER=none
# Leave empty for voicestudio. For OpenAI: STT_BASE_URL=https://api.openai.com/v1  STT_MODEL=whisper-1
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=

# --- Tools (OFF by default). TOOLS=public_apis lets her search/read/call the public-apis catalog (GET only).
# Build the catalog first:  npm run apis:update -w @waifu/server
# Needs a brain with tool use: anthropic, ollama (with a model that supports tools), or mock for demos.
# API keys for APIs that need them live ONLY on the server in data/api-keys.json (git-ignored), e.g.
#   { "api.example.com": { "header": "X-Api-Key", "value": "..." }, "other.com": { "query": "apikey", "value": "..." } }
# Actions that change things (files, clicks, typing, scripts) ALWAYS show an approval card; reading does not.
# Every requested action (approved or not) is appended to ACTIONS_LOG.
# files : read Word/Excel/PowerPoint/PDF/text and edit/create documents, ONLY inside WORKSPACE_DIRS
#         (default: Documents/AiWaifu in your user folder; several folders separated by ";" on Windows).
#         A copy of every file is saved in BACKUP_DIR before it is changed.
# WORKSPACE_DIRS=C:\Users\you\Documents\AiWaifu;C:\Users\you\Desktop\Proyectos
# BACKUP_DIR=data/backups
#         find_files searches Documents, Desktop, Downloads and OneDrive by default (read-only, names only);
#         files outside WORKSPACE_DIRS need an approved request_file_access, forgotten when the app closes.
# SEARCH_DIRS=C:\Users\you\Documents;D:\Proyectos
# ACTIONS_LOG=data/actions.jsonl
# APPROVAL_TIMEOUT_MS=120000
# browser : her own Chrome window in a SEPARATE profile (no access to your history, passwords or logins).
#           Opening/reading pages is free; clicking and typing need approval; she never fills password/payment fields.
#           Local/LAN addresses are blocked unless BROWSER_ALLOW_PRIVATE=1.
# BROWSER_CHANNEL=chrome        (or msedge)
# BROWSER_PROFILE_DIR=data/browser-profile
# vscode  : open workspace files in VS Code at a line (code edits go through write_text_file, with approval).
# blender : inspect .blend files (scripts embedded in them are never run) and run bpy scripts (approval shows the
#           whole script). Both use the workspace folders.
# VSCODE_CLI=C:\Users\you\AppData\Local\Programs\Microsoft VS Code\bin\code.cmd
# BLENDER_PATH=C:\Program Files\Blender Foundation\Blender 4.2\blender.exe
# desktop : general screen control (see the whole screen; click/type/press keys in ANY app: Canva, Lightworks,
#           Inventor...). Only works when the server is started by the desktop app (apps/desktop), which provides a
#           local endpoint protected by a secret token. Clicks, typing and key presses always need approval; the card
#           shows a fresh screenshot with the click point marked. Ctrl+Alt+Del and Win+L are refused.
# TOOLS=public_apis,screen,files,browser,vscode,blender,desktop  (screen = look_at_screen tool; needs a vision brain and the user sharing in the client)
TOOLS=
# Seconds-level pacing of unprompted screen comments ("continuous observation"), in ms.
WATCH_MIN_INTERVAL_MS=25000
# Ollama only: set to 1 if OLLAMA_MODEL is a vision-capable model.
OLLAMA_VISION=0
# PUBLIC_APIS_FILE=data/public-apis.json
# API_KEYS_FILE=data/api-keys.json

# --- Serving the app and phone access
# The server serves apps/web/dist (run `npm run build`) so one port gives UI + API. SERVE_WEB=0 to disable.
SERVE_WEB=1
# WEB_DIR=apps/web/dist
# HTTPS (required for the microphone on phones/tablets). Use a certificate your devices trust.
TLS_CERT=
TLS_KEY=
# Print a QR code with the pairing link at startup (only when HOST is not loopback and AUTH_TOKEN is set).
PAIR_QR=1

SOUL_FILE=souls/default.soul.json
MEMORY_FILE=data/memory.json
